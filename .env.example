# Docker Compose variables for LOCAL DEVELOPMENT.
# Setup: cp .env.example .env
# Real (staging/production) secrets never live in this repository.

# PostgreSQL — used to create the database AND passed to the Laravel containers
DB_DATABASE=reservehub
DB_USERNAME=reservehub
DB_PASSWORD=secret

# Host ports — change these if they clash with other projects
APP_PORT=8001
FORWARD_DB_PORT=5433
FORWARD_REDIS_PORT=6380